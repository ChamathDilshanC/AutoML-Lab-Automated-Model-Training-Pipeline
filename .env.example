# Variable names only. Copy to .env for local use; never commit real values.

# Backend (FastAPI)
APP_NAME=
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
# Or, instead of a URL (so the password can come from a secret store):
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=
MIGRATION_WAIT_SECONDS=
RUN_MIGRATIONS=
ARTIFACT_DIR=
MAX_UPLOAD_BYTES=
WORKER_POLL_SECONDS=
JOB_TIMEOUT_SECONDS=
REAPER_INTERVAL_SECONDS=
SECRET_KEY=
ACCESS_TOKEN_MINUTES=
PREDICT_RATE_LIMIT_PER_MINUTE=
LOGIN_RATE_LIMIT_PER_MINUTE=
PASSWORD_LOGIN_ENABLED=
DAILY_EXPERIMENT_LIMIT=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS=
SUPABASE_JWT_ALGORITHM=
TRUSTED_PROXY_HOPS=
MAX_PREDICTION_BATCH=
MAX_ARTIFACT_BYTES=
# JSON array of browser origins, e.g. ["http://localhost:3000"]; the deployed API allows
# ["https://automl-lab-ui.vercel.app"] (set by Terraform from frontend_origins).
CORS_ORIGINS=

# Files and jobs: local (default) or AWS. See docs/DEPLOYMENT.md.
STORAGE_MODE=
JOB_MODE=
AWS_REGION=
S3_BUCKET=
S3_PRESIGN_EXPIRES_SECONDS=
S3_ADDRESSING_STYLE=
SQS_QUEUE_URL=
SQS_WAIT_SECONDS=

# Frontend (Next.js)
# Base URL of the API, no trailing slash. Unset means http://localhost:8000 (local development).
# The deployed API is its Lambda Function URL (terraform output api_url), set in Vercel:
# https://qr2bs6hofh2mxilfqoz5uk2f5i0janut.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_API_BASE_URL=
# Supabase project URL, used only to start Google OAuth in the browser.
NEXT_PUBLIC_SUPABASE_URL=
