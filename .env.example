# Variable names only. Copy to .env for local use; never commit real values.

# Backend (FastAPI)
APP_NAME=
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
ARTIFACT_DIR=
MAX_UPLOAD_BYTES=
WORKER_POLL_SECONDS=
JOB_TIMEOUT_SECONDS=
REAPER_INTERVAL_SECONDS=
SECRET_KEY=
ACCESS_TOKEN_MINUTES=
PREDICT_RATE_LIMIT_PER_MINUTE=
LOGIN_RATE_LIMIT_PER_MINUTE=
MAX_PREDICTION_BATCH=
MAX_ARTIFACT_BYTES=
# JSON array, e.g. ["http://localhost:3000"]
CORS_ORIGINS=

# Frontend (Next.js)
# Files and jobs: local (default) or AWS. See docs/DEPLOYMENT.md.
STORAGE_MODE=
JOB_MODE=
AWS_REGION=
S3_BUCKET=
S3_PRESIGN_EXPIRES_SECONDS=
S3_ADDRESSING_STYLE=
SQS_QUEUE_URL=
SQS_WAIT_SECONDS=

NEXT_PUBLIC_API_BASE_URL=
