# Copy to terraform.tfvars (which is git-ignored) and adjust. Every value is optional.
region          = "us-east-1"   # the subnets use <region>a and <region>b unless availability_zones is set
allowed_origins = ["http://localhost:3000"]

# Required.
github_repository  = "ChamathDilshanC/AutoML-Lab-Automated-Model-Training-Pipeline"
budget_alert_email = "you@example.com"

# Origins of a frontend outside Amplify, e.g. the Vercel deployment (the Amplify origin is added
# automatically). No trailing slash.
# frontend_origins = ["https://automl-lab-ui.vercel.app"]

# Second and third apply (docs/DEPLOYMENT.md, "Apply order").
# enable_compute       = true
# worker_desired_count = 1

# Frontend on Amplify Hosting. The GitHub token never goes in this file: on the apply that creates
# the app, run `export TF_VAR_amplify_github_token=<token>` first.
# enable_frontend = true
